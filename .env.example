# TARS environment configuration
# Copy this file to .env and fill in real values as needed.
#
# The REQUIRED core path is fully local/free: openWakeWord + Silero VAD +
# faster-whisper + Fish Speech (or Kokoro) + OllamaProvider/ClaudeCodeProvider
# + SQLite. Every OPTIONAL paid provider below (AnthropicAPIProvider, hosted
# STT, hosted Fish Audio TTS) is an adapter behind the existing provider
# interfaces — never required for TARS to run.

# ---- General ----
TARS_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./tars.db

# ---- Mock trading events (V1 stand-in for quant_brain) ----
USE_MOCK_TRADING_EVENTS=true

# ---- quant_brain (future integration, not used in V1) ----
QUANT_BRAIN_BASE_URL=
QUANT_BRAIN_API_KEY=

# ---- Voice orchestration (Pipecat) ----
# webrtc = Pipecat-supported self-hosted WebRTC transport
PIPECAT_TRANSPORT=webrtc

# ---- Voice: wake word ----
# mock = disabled, push-to-talk/keyboard fallback assumed (always available)
# openwakeword = local openWakeWord adapter, phrase "TARS"
WAKE_WORD_PROVIDER=openwakeword
WAKE_WORD_PHRASE=TARS
WAKE_WORD_MODEL_PATH=

# ---- Voice: VAD ----
VAD_PROVIDER=silero

# ---- Voice: speech-to-text ----
# faster_whisper = local, default/required path; mock = offline/deterministic
# openai = OPTIONAL hosted adapter, not required
STT_PROVIDER=faster_whisper
FASTER_WHISPER_MODEL=base
OPENAI_API_KEY=

# ---- Voice: text-to-speech ----
# fish_speech = local, primary; kokoro = local, lightweight fallback
# mock = offline/no-op; fish_audio_hosted = OPTIONAL paid adapter, not required
TTS_PROVIDER=fish_speech
FISH_SPEECH_MODEL_PATH=
KOKORO_MODEL_PATH=
FISH_AUDIO_API_KEY=

# ---- Assistant ----
# claude_code = uses the user's own authenticated Claude Code environment (free for personal use)
# ollama = local/offline open-weight model runtime (Claude does NOT run inside Ollama)
# anthropic_api = OPTIONAL direct Anthropic API access, requires a paid key
# mock = offline canned/echo responses
ASSISTANT_PROVIDER=claude_code
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
ANTHROPIC_API_KEY=

# ---- Memory: operational + research ----
# Obsidian-compatible Markdown vault for human-readable research knowledge
OBSIDIAN_VAULT_PATH=./vault
# Enable sqlite-vec local semantic retrieval only if FTS5 proves insufficient
SQLITE_VEC_ENABLED=false
EMBEDDING_MODEL=

# ---- Scheduling (APScheduler) — housekeeping only, not live setup detection ----
TARS_TIMEZONE=UTC

# ---- Connectivity ----
# Preferred private access method for iPhone -> laptop-hosted TARS.
# Do not enable Tailscale Funnel (public exposure) for normal operation.
TAILSCALE_HOSTNAME=

# ---- Notifications ----
# iPhone PWA Web Push (optional; leave blank to disable push notifications)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# ---- Observability ----
# Leave blank for local/no-op export. OpenTelemetry instrumentation itself
# is always on; the exporter endpoint is what's optional.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Langfuse is OPTIONAL, not required for V1.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
