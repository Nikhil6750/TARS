# TARS environment configuration
# Copy this file to .env and fill in real values as needed.
# Every provider below has a "mock" mode — the application must run fully
# with no API keys configured, using mock/local providers.

# ---- General ----
TARS_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./tars.db

# ---- Mock trading events (V1 stand-in for quant_brain) ----
USE_MOCK_TRADING_EVENTS=true

# ---- quant_brain (future integration, not used in V1) ----
QUANT_BRAIN_BASE_URL=
QUANT_BRAIN_API_KEY=

# ---- Voice: wake word ----
# mock = no-op / disabled, push-to-talk fallback assumed
# openwakeword = local openWakeWord adapter
WAKE_WORD_PROVIDER=mock
WAKE_WORD_MODEL_PATH=

# ---- Voice: speech-to-text ----
# mock = offline/deterministic, openai = OpenAI transcription
STT_PROVIDER=mock
OPENAI_API_KEY=

# ---- Assistant ----
# mock = offline canned/echo responses, anthropic = Claude
ASSISTANT_PROVIDER=mock
ANTHROPIC_API_KEY=

# ---- Voice: text-to-speech ----
# mock = no-op/local, fish_audio = Fish Audio adapter
TTS_PROVIDER=mock
FISH_AUDIO_API_KEY=
